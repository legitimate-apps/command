# Command server — deployment settings. Copy to `.env` beside this file:
#
#   cp .env.example .env && docker compose up -d
#
# Every value is optional: the defaults in docker-compose.yml run a working server on your
# own network. `.env` is gitignored — real secrets never belong in the compose file.

# ---------------------------------------------------------------------------
# Reaching the server
# ---------------------------------------------------------------------------
# Which host interface to publish on. The default (0.0.0.0) is what lets your phone reach the
# server from elsewhere on your Wi-Fi. Use 127.0.0.1 ONLY when something on this same machine
# — a reverse proxy or a tunnel — is the only thing that should reach the container.
#COMMAND_BIND_ADDR=0.0.0.0
#COMMAND_HOST_PORT=9071

# Your server's public address, if it has one (a tunnel or proxy hostname). Used for absolute
# links. Leave unset on a LAN-only box.
#COMMAND_PUBLIC_BASE_URL=https://command.example.com

# Session cookie Secure flag. The default (auto) follows the request: Secure over HTTPS, not
# over plain http. Force it with true/false only if your proxy doesn't send X-Forwarded-Proto.
#COMMAND_COOKIE_SECURE=auto

#COMMAND_ENVIRONMENT=prod
#COMMAND_LOG_LEVEL=info

# self (default): your own server — the first account is its owner. cloud: a multi-tenant
# service configured entirely by env (the app then never offers to set an AI key).
#COMMAND_SERVER_KIND=self
# Signup. A self-hosted server closes it once its owner exists; true reopens it. On a cloud
# server this alone decides whether new accounts are accepted.
#COMMAND_ALLOW_REGISTRATION=false
# How many proxies in front of the server append to X-Forwarded-For, for per-IP rate limits.
# 0 ignores the header (safe default). Behind one proxy (Railway, or one Cloudflare hop): 1.
#COMMAND_TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# The assistant (optional)
# ---------------------------------------------------------------------------
# Your own model API key. Without it, notes still work — titles fall back to the first line
# and the assistant is unavailable. Command never proxies this through anyone else. You can
# instead paste the key in the app (owner only; stored encrypted on this server) — leave this
# unset for that, because a key set here always wins and can't be changed from the app.
#COMMAND_AI_API_KEY=
#COMMAND_AI_TITLE_MODEL=qwen/qwen3.8-flash

# ---------------------------------------------------------------------------
# Push reminders (optional — needs an Apple Developer account)
# ---------------------------------------------------------------------------
# Put your APNs .p8 in `deploy/keys/`, which is mounted read-only at /keys. Push is a no-op
# while these are unset, so you can ignore this whole section.
#COMMAND_APNS_KEY_PATH=/keys/AuthKey_XXXXXXXXXX.p8
# Or, on a host without files (Railway): the .p8's contents, newlines as \n.
#COMMAND_APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#COMMAND_APNS_KEY_ID=XXXXXXXXXX
#COMMAND_APNS_TEAM_ID=XXXXXXXXXX
#COMMAND_APNS_TOPIC=com.example.command

# ---------------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------------
# Subscriptions. Leave off unless you are actually billing.
#COMMAND_REVENUECAT_WEBHOOK_TOKEN=
#COMMAND_AGENT_REQUIRE_SUBSCRIPTION=false
# A RevenueCat v1 API key lets this server confirm purchases itself when the app refreshes —
# needed when the RevenueCat webhook points at a different server. A v1 secret key or the app's
# public SDK key both work; v2 secret keys are refused by this endpoint.
#COMMAND_REVENUECAT_API_KEY=

# Operator backups: GET /api/admin/backup with "Authorization: Bearer <token>" streams a
# tar.gz of the database and attachments. Unset = the endpoint doesn't exist.
#COMMAND_BACKUP_TOKEN=

# Per-account ceilings (0 = unlimited). The defaults are far above real use.
#COMMAND_MAX_ATTACHMENT_BYTES_PER_ACCOUNT=2147483648
#COMMAND_MAX_ATTACHMENTS_PER_ACCOUNT=5000
#COMMAND_MAX_NOTES_PER_ACCOUNT=100000
#COMMAND_MAX_ASSIGNMENTS_PER_ACCOUNT=50000
#COMMAND_MAX_ACTIVITIES_PER_ACCOUNT=200000

# Secrets for agent-to-agent peering and calendar (.ics) links. Generated automatically on
# first start and stored in the data volume; set them only to pin your own values.
#COMMAND_PEER_TOKEN_KEY=
#COMMAND_CALENDAR_EXPORT_SECRET=

# Container limits.
#COMMAND_MEM_LIMIT=256m
#COMMAND_CPUS=1.0
