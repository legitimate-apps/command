<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Store export options. Manual signing: an ASC API key cannot do Xcode
     cloud signing, so we sign against the locally-installed "Command CI"
     provisioning profile (created via the ASC API; includes both Legitimate LLC
     distribution certs so it matches whichever key is in the login keychain).
     destination=export -> produces an IPA; upload to TestFlight is a separate,
     gated step so a build is never auto-submitted. -->
<plist version="1.0">
<dict>
  <key>method</key><string>app-store-connect</string>
  <key>destination</key><string>export</string>
  <key>teamID</key><string>3LTL47SJ8C</string>
  <key>signingStyle</key><string>manual</string>
  <key>signingCertificate</key><string>Apple Distribution</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.legitimateapps.command</key><string>Command CI</string>
    <!-- The embedded widget extension signs separately, against its own App ID, so it
         needs its own entry here — export fails outright without it. Both profiles must
         carry the group.com.legitimateapps.command App Group; the widget reads the
         shared container the host writes. -->
    <key>com.legitimateapps.command.widgets</key><string>Command Widgets CI</string>
  </dict>
  <key>uploadSymbols</key><true/>
  <key>stripSwiftSymbols</key><true/>
</dict>
</plist>
