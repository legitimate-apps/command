# Command server configuration (env prefix: COMMAND_)
# Copy to .env for local dev. Real secrets never get committed.

# SQLite database path. In Docker this is a mounted volume, e.g. /data/command.db
COMMAND_DB_PATH=./data/command.db

# Bind. Keep on loopback in production; a reverse proxy or tunnel reaches it there.
COMMAND_HTTP_HOST=127.0.0.1
COMMAND_HTTP_PORT=8000

# dev | prod  (prod tightens cookie + bearer policy)
COMMAND_ENVIRONMENT=dev
COMMAND_LOG_LEVEL=info

# Auth
COMMAND_SESSION_DAYS=30
COMMAND_TOKEN_WORDS=3
# auto (default): Secure over HTTPS, not over plain http. true/false force it.
COMMAND_COOKIE_SECURE=auto

# MCP (Phase 3)
COMMAND_MCP_PATH=/mcp
# Absolute base URL the app/agent reach the server at, e.g. https://command.example.tld
COMMAND_PUBLIC_BASE_URL=

# AI — note titles (and, later, the agentic backend). OpenAI-compatible endpoint.
# Leave COMMAND_AI_API_KEY blank to disable AI titles (they fall back to the first line).
COMMAND_AI_BASE_URL=https://openrouter.ai/api/v1
COMMAND_AI_API_KEY=
COMMAND_AI_TITLE_MODEL=qwen/qwen3.8-flash

# Agent (Phase B) — reuses COMMAND_AI_API_KEY (OpenRouter) for every tier.
# Three tiers: Sonnet (default route), Haiku (fast), Opus (escalation). Slugs are
# OpenRouter's (dotted minor versions), not Anthropic's dashed API ids.
COMMAND_AGENT_MODEL_CLAUDE=anthropic/claude-sonnet-5
COMMAND_AGENT_MODEL_FAST=anthropic/claude-haiku-4.5
COMMAND_AGENT_MODEL_OPUS=anthropic/claude-opus-5.5
# Non-Anthropic alternates on the same key. GLM is the budget tier and is TEXT-ONLY,
# so it's listed in COMMAND_AGENT_TEXT_ONLY_MODELS — image turns fall back to Claude.
COMMAND_AGENT_MODEL_GLM=z-ai/glm-5.3
COMMAND_AGENT_MODEL_KIMI=moonshotai/kimi-k3
COMMAND_AGENT_MODEL_GPT=openai/gpt-6-sol
COMMAND_AGENT_TEXT_ONLY_MODELS=z-ai/glm-5.3
# deny | allow — refuse OpenRouter providers that may train on prompts. Keep "deny".
COMMAND_AI_PROVIDER_DATA_COLLECTION=deny
COMMAND_AGENT_MONTHLY_CAP_USD=10
COMMAND_AGENT_CLAUDE_WEIGHT=0.8
